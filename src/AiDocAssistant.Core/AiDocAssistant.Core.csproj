<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Тип Vector для эмбеддинга в сущности Chunk. Пакет крошечный (только value-тип),
         EF-интеграция (Pgvector.EntityFrameworkCore) остаётся в Infrastructure. -->
    <PackageReference Include="Pgvector" Version="0.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Evals\Golden\*.json" />
  </ItemGroup>

</Project>
